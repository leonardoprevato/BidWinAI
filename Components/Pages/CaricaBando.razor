@page "/carica-bando"
@using Microsoft.AspNetCore.Components.Forms
@using BidWinAI.Models
@using BidWinAI.Services
@using System.IO
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

@inject BandoService BandoService
@inject AppDbContext DbContext

<div class="max-w-6xl mx-auto p-6 bg-white rounded-xl shadow-sm mt-6">
    <h3 class="text-2xl font-bold text-gray-800 mb-2">Carica Nuovo Bando</h3>
    <p class="text-gray-600 mb-6">I file caricati verranno accumulati nella lista sottostante.</p>

    <div
        class="relative border-3 border-dashed border-blue-500 hover:border-blue-600 bg-blue-50/50 hover:bg-blue-50 p-10 text-center rounded-xl cursor-pointer transition duration-200 group">
        <p class="text-gray-700 font-medium group-hover:text-blue-700 transition">
            📄 Trascina qui il file PDF del bando o <span class="text-blue-600 underline">clicca per cercarlo</span>
        </p>
        <InputFile OnChange="GestisciFileCaricato" accept=".pdf" multiple
                   class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
    </div>

    @if (listaFiles.Any())
    {
        <h4 class="text-lg font-semibold text-gray-800 mt-6 mb-3">File pronti nella Lista (@listaFiles.Count):</h4>

        <div class="flex flex-col gap-3">
            @foreach (var file in listaFiles)
            {
                <div class="flex items-center p-4 bg-green-50 border border-green-200 text-green-900 rounded-lg shadow-sm">
                    <span class="text-2xl mr-4">📄</span>
                    <div class="flex flex-col">
                        <strong class="font-semibold break-all">@file.Name</strong>
                        <span class="text-sm text-gray-500">(@(file.Size / 1024) KB)</span>
                    </div>
                </div>
            }
        </div>

        <button
            class="mt-5 px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg shadow-md hover:shadow-lg transition duration-200 flex items-center gap-2"
            @onclick="SalvaBandiSuPostgres">
            <span>💾</span> Salva nel Database e sul Disco
        </button>
    }

    @if (!string.IsNullOrEmpty(messaggioStato))
    {
        var isErrore = messaggioStato.StartsWith("❌");
        <div
            class="@(isErrore ? "bg-red-50 border-red-200 text-red-800" : "bg-emerald-50 border-emerald-200 text-emerald-800") mt-5 p-4 border rounded-lg font-medium shadow-sm transition duration-150">
            @messaggioStato
        </div>
    }

    <hr class="my-10 border-t-2 border-gray-100" />

    <h3 class="text-2xl font-bold text-gray-800 mb-4 flex items-center gap-2">
        <span>📌</span> Archivio Bandi nel Database
    </h3>

    @if (bandiSalvati == null)
    {
        <div class="flex items-center gap-2 text-gray-500 italic p-4">
            <div class="animate-spin h-5 w-5 border-2 border-blue-500 border-t-transparent rounded-full"></div>
            Caricamento dati da PostgreSQL...
        </div>
    }
    else if (!bandiSalvati.Any())
    {
        <div class="p-4 bg-amber-50 border border-amber-200 text-amber-800 rounded-lg font-medium">
            Nessun bando presente nel database. Usa la zona sopra per caricarne uno!
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
            <table class="min-w-full divide-y divide-gray-200 bg-white">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3.5 text-left text-sm font-bold text-gray-700 tracking-wider">ID</th>
                        <th class="px-6 py-3.5 text-left text-sm font-bold text-gray-700 tracking-wider">Nome File</th>
                        <th class="px-6 py-3.5 text-left text-sm font-bold text-gray-700 tracking-wider">Dimensione</th>
                        <th class="px-6 py-3.5 text-left text-sm font-bold text-gray-700 tracking-wider">Data Caricamento
                        </th>
                        <th class="px-6 py-3.5 text-left text-sm font-bold text-gray-700 tracking-wider">Stato</th>
                        <th class="px-6 py-3.5 text-left text-sm font-bold text-gray-700 tracking-wider">Azioni</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var bando in bandiSalvati)
                    {
                        <tr class="hover:bg-gray-50/70 transition duration-150">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">@bando.Id</td>
                            <td class="px-6 py-4 text-sm text-gray-900 font-medium max-w-xs break-all">@bando.NomeFile</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(bando.Dimensione / 1024) KB</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @bando.DataCaricamento.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    @if (bando.Stato == StatoBando.InCoda)
                                    {
                                        <span
                                            class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">⏳
                                            In Coda</span>
                                        }
                                else if (bando.Stato == StatoBando.InElaborazione)
                                        {
                                            <span
                                                class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 animate-pulse">⚙️
                                                In Elaborazione IA...</span>
                                            }
                                else if (bando.Stato == StatoBando.Completato)
                                            {
                                                <span
                                                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">✅
                                                    Pronto</span>
                                                }
                                else if (bando.Stato == StatoBando.Fallito)
                                                {
                                                    <span
                                                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800"
                                                    title="@bando.MessaggioErrore">❌ Fallito</span>
                                                }
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex gap-2">
                                                <a href="@bando.PercorsoFile" target="_blank"
                                                   class="inline-flex items-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition duration-150 no-underline shadow-sm text-xs font-semibold">
                                                    👁️ PDF
                                                </a>

                                                <button
                                                    class="inline-flex items-center px-3 py-1.5 bg-cyan-600 hover:bg-cyan-700 disabled:opacity-40 disabled:hover:bg-cyan-600 text-white rounded-md transition duration-150 shadow-sm text-xs font-semibold disabled:cursor-not-allowed"
                                                    disabled="@(bando.Stato != StatoBando.Completato)" @onclick="() => SelezionaBando(bando)">
                                                    🤖 Risposta IA
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (bandoSelezionato != null)
                    {
                        <div
                            class="mt-8 border border-gray-200 rounded-xl bg-gray-50 shadow-lg overflow-hidden transition-all duration-300">
                            <div class="flex justify-between items-center px-5 py-3.5 bg-gray-100 border-b border-gray-200">
                                <strong class="text-gray-800 font-semibold flex items-center gap-2">
                                    <span>🤖</span> Analisi del file: <span
                                    class="text-blue-600 font-mono break-all">@bandoSelezionato.NomeFile</span>
                                </strong>
                                <button class="text-gray-400 hover:text-gray-600 transition text-lg p-1"
                                        @onclick="() => bandoSelezionato = null">✕</button>
                            </div>
                            <pre
                            class="p-5 m-0 font-mono text-sm white-space-pre-wrap break-words max-h-[500px] overflow-y-auto bg-white text-gray-800 leading-relaxed">@bandoSelezionato.AnalisiIA</pre>
                        </div>
                    }
                </div>

@code {
    public List<IBrowserFile> listaFiles = new();
    private string messaggioStato = "";
    private List<Bando> bandiSalvati = new();
    private Bando? bandoSelezionato;

    protected override async Task OnInitializedAsync()
    {
        await AggiornaListaDaDatabase();
    }

    private async Task AggiornaListaDaDatabase()
    {
        bandiSalvati = await DbContext.Bandi
            .Include(b => b.Utente)
            .OrderByDescending(b => b.DataCaricamento)
            .ToListAsync();
    }

    private void GestisciFileCaricato(InputFileChangeEventArgs e)
    {
        messaggioStato = "";
        foreach (var file in e.GetMultipleFiles())
        {
            listaFiles.Add(file);
        }
    }

    private void SelezionaBando(Bando bando)
    {
        bandoSelezionato = bando;
    }

    private async Task SalvaBandiSuPostgres()
    {
        try
        {
            messaggioStato = "⏳ Invio dei file al server...";
            StateHasChanged();

            foreach (var file in listaFiles)
            {
                await BandoService.SalvaInCodaAsync(file);
            }

            listaFiles.Clear();
            messaggioStato = "🚀 File caricati con successo! Il motore IA li sta analizzando in background. Aggiorna la pagina tra qualche istante.";

            await AggiornaListaDaDatabase();
        }
        catch (Exception ex)
        {
            messaggioStato = "❌ Errore durante il caricamento: " + ex.Message;
        }
    }
}