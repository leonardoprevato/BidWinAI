@page "/archivio-bandi"
@using BidWinAI.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

@inject IDbContextFactory<AppDbContext> DbFactory

<div class="mx-auto p-6 bg-white rounded-xl shadow-sm mt-6 w-full">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-100 pb-5 mb-6 gap-4">
        <div>
            <h3 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pin-angle" viewBox="0 0 16 16">
                        <path d="M9.828.722a.5.5 0 0 1 .354.146l4.95 4.95a.5.5 0 0 1 0 .707c-.48.48-1.072.588-1.503.588-.177 0-.335-.018-.46-.039l-3.134 3.134a6 6 0 0 1 .16 1.013c.046.702-.032 1.687-.72 2.375a.5.5 0 0 1-.707 0l-2.829-2.828-3.182 3.182c-.195.195-1.219.902-1.414.707s.512-1.22.707-1.414l3.182-3.182-2.828-2.829a.5.5 0 0 1 0-.707c.688-.688 1.673-.767 2.375-.72a6 6 0 0 1 1.013.16l3.134-3.133a3 3 0 0 1-.04-.461c0-.43.108-1.022.589-1.503a.5.5 0 0 1 .353-.146m.122 2.112v-.002zm0-.002v.002a.5.5 0 0 1-.122.51L6.293 6.878a.5.5 0 0 1-.511.12H5.78l-.014-.004a5 5 0 0 0-.288-.076 5 5 0 0 0-.765-.116c-.422-.028-.836.008-1.175.15l5.51 5.509c.141-.34.177-.753.149-1.175a5 5 0 0 0-.192-1.054l-.004-.013v-.001a.5.5 0 0 1 .12-.512l3.536-3.535a.5.5 0 0 1 .532-.115l.096.022c.087.017.208.034.344.034q.172.002.343-.04L9.927 2.028q-.042.172-.04.343a1.8 1.8 0 0 0 .062.46z" />
                    </svg>
                </span> Archivio Storico Bandi
            </h3>
            <p class="text-gray-500 text-sm mt-1">Gestisci, ricerca e consulta tutti i bandi caricati nel sistema e le relative analisi IA.</p>
        </div>
        <a href="/carica-bando" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-sm transition text-sm">
            <span>➕</span> Carica Nuovo Bando
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 p-4 bg-gray-50 rounded-xl border border-gray-100">
        <div>
            <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-1.5">Cerca per nome file</label>
            <div class="relative">
                <input type="text"
                       class="w-full pl-3 pr-10 py-2 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-blue-500 transition text-gray-800"
                       placeholder="Scrivi il nome del file..."
                       @bind="testoRicerca"
                       @bind:event="oninput"
                       @onkeyup="ApplicaFiltri" />
                @if (!string.IsNullOrEmpty(testoRicerca))
                {
                    <button class="absolute right-2.5 top-2.5 text-gray-400 hover:text-gray-600 text-xs" @onclick="SvuotaRicerca">✕</button>
                }
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-1.5">Filtra per Stato</label>
            <select class="w-full px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-blue-500 transition text-gray-800"
                    @onchange="FiltraPerStato">
                <option value="Tutti">All / Mostra Tutti</option>
                <option value="InCoda">In Coda</option>
                <option value="InElaborazione">In Elaborazione IA</option>
                <option value="Completato">Pronti / Completati</option>
                <option value="Fallito">Falliti</option>
            </select>
        </div>

        <div class="flex items-end justify-end">
            <button class="w-full md:w-auto px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium rounded-lg text-sm transition flex items-center justify-center gap-2"
                    @onclick="AggiornaListaDaDatabase">
                <span>Aggiorna Tabella</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(messaggioStato))
    {
        var isErrore = messaggioStato.StartsWith("❌");
        <div class="@(isErrore ? "bg-red-50 border-red-200 text-red-800" : "bg-emerald-50 border-emerald-200 text-emerald-800") mb-5 p-4 border rounded-lg font-medium shadow-sm flex justify-between items-center text-sm animate-fade-in">
            <span>@messaggioStato</span>
            <button class="font-bold ml-2 hover:opacity-70" @onclick="() => messaggioStato = string.Empty">✕</button>
        </div>
    }

    @if (bandiFiltrati == null)
    {
        <div class="flex items-center justify-center gap-2 text-gray-500 italic p-12 bg-gray-50/50 rounded-xl border border-dashed border-gray-200">
            <div class="animate-spin h-5 w-5 border-2 border-blue-500 border-t-transparent rounded-full"></div>
            Caricamento archivio da PostgreSQL...
        </div>
    }
    else if (!bandiFiltrati.Any())
    {
        <div class="p-8 bg-amber-50 border border-amber-100 text-amber-800 rounded-xl text-center font-medium">
            <span class="text-2xl block mb-2"></span>
            Nessun bando trovato con i filtri selezionati.
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm bg-white">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider w-16">ID</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Nome File</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider w-32">Dimensione</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider w-44">Data Caricamento</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider w-40">Stato</th>
                        <th class="px-6 py-3.5 text-center text-xs font-bold text-gray-500 uppercase tracking-wider w-48">Azioni</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var bando in bandiFiltrati)
                    {
                        <tr class="@(bandoSelezionato?.Id == bando.Id ? "bg-blue-50/40 font-medium" : "hover:bg-gray-50/70") transition duration-150">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-400">@bando.Id</td>
                            <td class="px-6 py-4 text-sm text-gray-900 font-medium max-w-xs truncate" title="@bando.NomeFile">@bando.NomeFile</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(bando.Dimensione / 1024) KB</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @bando.DataCaricamento.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                @if (bando.Stato == StatoBando.InCoda)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">⏳ In Coda</span>
                                }
                                else if (bando.Stato == StatoBando.InElaborazione)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 animate-pulse">⚙️ In Elaborazione...</span>
                                }
                                else if (bando.Stato == StatoBando.Completato)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">Processato</span>
                                }
                                else if (bando.Stato == StatoBando.Fallito)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800" title="@bando.MessaggioErrore">❌ Fallito</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-center font-medium flex justify-center gap-1.5">
                                <a href="@bando.PercorsoFile" target="_blank"
                                   class="inline-flex items-center px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-md transition no-underline text-xs font-semibold shadow-sm" title="Vedi File PDF Originale">
                                    PDF
                                </a>
                                <a href="analisi-bando/@bando.Id" class="bg-blue-600 text-white px-3 py-1.5 rounded text-sm font-semibold no-underline">
                                    Chatta con IA
                                </a>
                                <button class="inline-flex items-center px-2.5 py-1.5 bg-blue-600 hover:bg-blue-700 disabled:opacity-40 text-white rounded-md transition text-xs font-semibold shadow-sm disabled:cursor-not-allowed"
                                        disabled="@(bando.Stato != StatoBando.Completato)"
                                        @onclick="() => SelezionaBando(bando)" title="Visualizza Analisi Intelligenza Artificiale">
                                    Risposta IA
                                </button>

                                <button class="inline-flex items-center px-2.5 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-md transition text-xs font-semibold"
                                        @onclick="() => EliminaBando(bando)" title="Elimina definitivamente">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (bandoSelezionato != null)
    {
        <div class="mt-8 border border-blue-100 rounded-xl bg-blue-50/20 shadow-md overflow-hidden transition-all duration-300 animate-fade-in">
            <div class="flex justify-between items-center px-5 py-3.5 bg-blue-50 border-b border-blue-100">
                <strong class="text-gray-800 font-semibold flex items-center gap-2 text-base">
                    <span>🤖</span> Analisi Estratta per: <span class="text-blue-700 font-mono text-sm break-all">@bandoSelezionato.NomeFile</span>
                </strong>
                <button class="text-gray-400 hover:text-gray-600 transition text-xl p-1 font-bold"
                        @onclick="() => bandoSelezionato = null">
                    ✕
                </button>
            </div>
            <pre class="p-5 m-0 font-mono text-sm white-space-pre-wrap break-words max-h-[600px] overflow-y-auto bg-white text-gray-800 leading-relaxed shadow-inner">@bandoSelezionato.AnalisiIA</pre>
        </div>
    }
</div>

@code {
    private List<Bando> tuttiBandi = new();
    private List<Bando> bandiFiltrati = new();

    private string testoRicerca = "";
    private string statoSelezionatoStr = "Tutti";
    private string messaggioStato = "";
    private Bando? bandoSelezionato;

    protected override async Task OnInitializedAsync()
    {
        await AggiornaListaDaDatabase();
    }

    private async Task AggiornaListaDaDatabase()
    {
        try
        {
            // 1. Chiediamo un contesto fresco alla fabbrica
            using var context = await DbFactory.CreateDbContextAsync();

            // 2. Usiamo AsNoTracking() perché stiamo solo leggendo dati (molto più veloce e pulito)
            tuttiBandi = await context.Bandi
                .Include(b => b.Utente)
                .OrderByDescending(b => b.DataCaricamento)
                .AsNoTracking()
                .ToListAsync();

            ApplicaFiltri();
        }
        catch (Exception ex)
        {
            messaggioStato = "❌ Errore nel caricamento dei dati: " + ex.Message;
        }
    }

    private void ApplicaFiltri()
    {
        var query = tuttiBandi.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(testoRicerca))
        {
            query = query.Where(b => b.NomeFile.Contains(testoRicerca, StringComparison.OrdinalIgnoreCase));
        }

        if (statoSelezionatoStr != "Tutti")
        {
            if (Enum.TryParse<StatoBando>(statoSelezionatoStr, out var statoEnum))
            {
                query = query.Where(b => b.Stato == statoEnum);
            }
        }

        bandiFiltrati = query.ToList();

        if (bandoSelezionato != null && !bandiFiltrati.Any(b => b.Id == bandoSelezionato.Id))
        {
            bandoSelezionato = null;
        }
    }

    private void FiltraPerStato(ChangeEventArgs e)
    {
        statoSelezionatoStr = e.Value?.ToString() ?? "Tutti";
        ApplicaFiltri();
    }

    private void SvuotaRicerca()
    {
        testoRicerca = string.Empty;
        ApplicaFiltri();
    }

    private void SelezionaBando(Bando bando)
    {
        bandoSelezionato = bando;
    }

    private async Task EliminaBando(Bando bando)
    {
        messaggioStato = "";

        try
        {
            // 1. Chiediamo un altro contesto fresco alla fabbrica per l'eliminazione
            using var context = await DbFactory.CreateDbContextAsync();

            // 2. Cerchiamo il bando all'interno di QUESTO contesto specifico per ID
            var bandoDaEliminare = await context.Bandi.FindAsync(bando.Id);

            if (bandoDaEliminare != null)
            {
                context.Bandi.Remove(bandoDaEliminare);
                await context.SaveChangesAsync();

                messaggioStato = $"🗑️ Il bando '{bando.NomeFile}' è stato eliminato con successo dall'archivio.";
            }
            else
            {
                messaggioStato = "❌ Impossibile eliminare: bando non trovato nel database.";
            }

            if (bandoSelezionato?.Id == bando.Id)
            {
                bandoSelezionato = null;
            }

            // 3. Rinfreschiamo l'interfaccia rileggendo da Postgres
            await AggiornaListaDaDatabase();
        }
        catch (Exception ex)
        {
            messaggioStato = "❌ Impossibile eliminare il bando: " + ex.Message;
        }
    }
}