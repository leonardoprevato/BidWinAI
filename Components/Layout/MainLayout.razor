@inherits LayoutComponentBase

<div class="flex min-h-screen bg-slate-50/50 font-sans antialiased">

    <!-- Barra Laterale (Sidebar Desktop) -->
    <aside class="w-64 bg-slate-900 border-r border-slate-800/40 hidden md:flex flex-col flex-shrink-0 z-30">
        <NavMenu />
    </aside>

    <!-- Area Principale di Lavoro -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- Contenitore Dinamico delle Pagine (@Body) -->
        <main class="flex-1 overflow-y-auto">
            <article class="p-4 md:p-8 max-w-6xl mx-auto">
                @Body
            </article>
        </main>
    </div>
</div>

<!-- Banner di Errore Blazor (Stile Toast Notifica Premium) -->
<div id="blazor-error-ui"
     class="hidden fixed bottom-5 right-5 max-w-md bg-white border border-gray-200/80 p-4 rounded-xl shadow-2xl z-50 text-slate-800 text-sm min-w-[320px]"
     data-nosnippet>
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
            <span class="text-base">⚠️</span>
            <span class="font-medium">Si è verificato un errore interno.</span>
        </div>
        <div class="flex items-center gap-2">
            <a href="."
               class="reload px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-700 font-bold rounded-md no-underline transition text-xs shadow-3xs">
                Ricarica
            </a>
            <span
            class="dismiss cursor-pointer text-slate-400 hover:text-slate-600 p-1 text-base font-bold select-none transition">✕</span>
        </div>
    </div>
</div>